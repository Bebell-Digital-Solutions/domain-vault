# ============================================================================
# Domain Vault backend — environment
#
# Copy to .env and fill in. Never commit .env.
#
# The service role key bypasses every security policy in the database. It
# belongs in Edge Function secrets and in your local .env only — never in the
# frontend, never in the repo.
# ============================================================================


# --- Supabase connection ---------------------------------------------------
# NOT set here, deliberately, and there are two reasons:
#
#  1. The Edge Function runtime injects SUPABASE_URL, SUPABASE_ANON_KEY and
#     SUPABASE_SERVICE_ROLE_KEY automatically, both locally and when deployed.
#     Overriding SUPABASE_URL locally breaks the functions: inside the runtime
#     container 127.0.0.1 is the container itself, not the API gateway.
#  2. `supabase secrets set` refuses any name beginning with SUPABASE_.
#
# The Node scripts in scripts/ DO need them, because they run on the host.
# Export those in your shell instead:
#
#     export SUPABASE_URL=$(supabase status -o json | jq -r .API_URL)
#     export SUPABASE_SERVICE_ROLE_KEY=$(supabase status -o json | jq -r .SERVICE_ROLE_KEY)

# --- Credential encryption -------------------------------------------------
# Generate with: openssl rand -base64 32
# Losing this key makes every stored registrar password unrecoverable.
# Back it up in a password manager, not in this repo.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=1
# During a key rotation, put the old key here so existing rows still decrypt.
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=

# --- Site ------------------------------------------------------------------
SITE_URL=https://domain-vault.elnegocio.digital
# Comma-separated. Only these origins may call the API from a browser.
ALLOWED_ORIGINS=https://domain-vault.elnegocio.digital,http://localhost:5173

# --- Admin notifications ---------------------------------------------------
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PHONE=+10000000000

# --- Transactional email (https://resend.com) ------------------------------
# Left blank, email is skipped and logged instead. Useful for local dev.
RESEND_API_KEY=
MAIL_FROM=Domain Vault <noreply@yourdomain.com>

# --- WhatsApp Cloud API (Meta), optional -----------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- PayPal ----------------------------------------------------------------
# 'sandbox' routes IPN verification to PayPal's sandbox.
PAYPAL_ENV=live
# The webhook refuses payments addressed to any other receiver.
PAYPAL_RECEIVER_EMAIL=payments@yourdomain.com
